<?xml version="1.0" encoding="UTF-8"?>
<!--
  Coc Docs Platform — backend service.

  Java 21 · Spring Boot 3.4 · Maven, per CONST-TECH-06 (the organisation's
  baseline language, HARNESS-PROCESS-STANDARD §5.7) and ADR-012 §1.

  Deliberately provider-agnostic: plain PostgreSQL over JDBC with Flyway
  migrations, and S3-API object storage. Backend hosting is [DEFERRED]
  (PM, 2026-09-08), so nothing here may depend on a specific provider —
  see CONST-TECH-08 and ADR-012 §2.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>com.coc</groupId>
  <artifactId>docs-platform-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Coc Docs Platform Backend</name>
  <description>REST API for documentation content, navigation, media and accounts</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- CONST-OPS-01: content includes Khmer and Korean. Encoding is never
         left to the platform default on this project. -->
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Overrides the version Spring Boot 3.4.1 manages (1.15.x), which refuses
         to instrument class files newer than Java 24. Mockito is built on
         Byte Buddy, so on a JDK 25 toolchain every mock-based test fails to
         start. The compiler still targets Java 21 (CONST-TECH-06); this only
         affects what the test JVM can instrument.

         Remove when the managed version supports the JDK in use. -->
    <byte-buddy.version>1.18.13</byte-buddy.version>

    <!-- AWS SDK v2's S3 client, used only as a generic client for the
         S3-compatible API (CONST-TECH-08): MinIO locally, whichever
         provider is chosen once backend hosting is decided (ADR-012 §2,
         still [DEFERRED]). Nothing in this project depends on AWS itself. -->
    <aws-sdk.version>2.54.14</aws-sdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Authorisation is enforced here, in the service layer, never in the
         database and never in the frontend. CONST-TECH-07, ADR-012 §3. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- The sign-in credential is a JWT; verified server-side against the
         configured issuer's JWK set (Keycloak's realm, which brokers Google
         upstream — ADR-013, revising ADR-008). The frontend never asserts
         identity. FR-AUTH-001, ADR-012 §4. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- Bean validation on request bodies, in addition to the block-model
         validator. NFR-SEC-SANITIZE. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Password-reset link delivery (ADR-017). Autoconfigures a
         JavaMailSender bean only when spring.mail.host is set; where it is
         not, PasswordResetMailer falls back to logging the link instead of
         failing the boot, the same optional-bean shape as the Keycloak
         broker (KeycloakAuthConfig). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- Push notifications (ADR-025). Optional at runtime: FirebaseConfig only
         creates a FirebaseMessaging when app.firebase.credentials is set, and
         PushSender takes it through an ObjectProvider, so a developer without
         a service account gets a log line instead of a broken application. -->
    <dependency>
      <groupId>com.google.firebase</groupId>
      <artifactId>firebase-admin</artifactId>
      <version>9.4.1</version>
    </dependency>

    <!-- TOTP second factor (ADR-031): RFC 6238 code generation/verification
         with time-window tolerance. Don't hand-roll HMAC-based OTP crypto,
         same reasoning as reusing PasswordEncoder for bcrypt rather than a
         custom hash. -->
    <dependency>
      <groupId>dev.samstevens.totp</groupId>
      <artifactId>totp</artifactId>
      <version>1.7.1</version>
    </dependency>
    <!-- QR code rendering that dev.samstevens.totp's QrGenerator delegates to
         (ADR-031): the setup wizard's scannable QR image. -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>3.5.3</version>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
      <version>3.5.3</version>
    </dependency>

    <!-- The OpenAPI contract is generated from the annotated controllers
         themselves (served at /v3/api-docs), not hand-maintained separately,
         so the frontend's generated client cannot silently drift from the
         real API. RISK-018, architecture-overview.md §11. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.7.0</version>
    </dependency>

    <!-- Plain JDBC, not JPA. The schema is jsonb-heavy and hand-tuned
         (ADR-003); an ORM would fight it for no benefit at this scale. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Plain-SQL migrations, portable across any Postgres host. CONST-TECH-08. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Object storage behind the S3 API (CONST-TECH-08): self-uploaded
         profile photos (ADR-026). Path-style requests only
         (AvatarStorageConfig), the one addressing scheme every S3-compatible
         provider is guaranteed to support. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>apache-client</artifactId>
    </dependency>

    <!-- ===================== test ===================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Integration tests run against real Postgres, not an in-memory
         substitute: the schema relies on partial unique indexes, a deferred
         constraint trigger and jsonb, none of which H2 reproduces faithfully. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @Testcontainers/@Container (JUnit 5 lifecycle) — not pulled in by
         spring-boot-testcontainers or testcontainers:postgresql alone. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-parameters</arg>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!--
        Fail the build on the wrong JDK rather than asking six people to be
        careful. RISK-020: one developer reported Java 25 on day one while
        CONST-TECH-06 specifies 21. The build still succeeded, because the
        release target is 21 regardless of which JDK compiles it — which is
        exactly why the divergence went unnoticed.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>
This project requires Java 21 (CONST-TECH-06). You are building with a
different JDK.

Spring Boot 3.4 predates Java 25 and does not list it as supported, and
six developers on differing JDKs produces defects that reproduce on one
machine only.

Install JDK 21 and make sure `java -version` reports 21 for this project.
SDKMAN, jEnv, or your IDE's per-project SDK setting all handle this.
                  </message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                  <message>This project requires Maven 3.9 or newer.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
