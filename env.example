# Coc Docs Platform — backend environment
#
# Copy to env.local and fill in. env.local is gitignored; this file is not, and
# must never hold a real credential.
#
#   cp backend/env.example backend/env.local
#
# Every variable application.yml reads is listed here. scripts/check-env-documented.sh
# fails the build if that stops being true, because an undocumented variable is
# one a new developer discovers from a stack trace.
#
# Values below are defaults for a local machine, not for any deployed
# environment.

# ── Database ────────────────────────────────────────────────────────────────
# Any PostgreSQL 15+ instance. Provider-agnostic by constraint (CONST-TECH-08):
# plain JDBC, Flyway migrations, nothing host-specific.
#
# Point this at a shared box rather than committing that host as a default —
# a committed LAN address fails for anyone at home or on VPN, and the error
# does not say why.
DB_URL=jdbc:postgresql://localhost:5432/cocdocs?currentSchema=cocdocs_dev
DB_USER=cocdocs
DB_PASSWORD=

# Hikari's maximum pool size. Raise for load testing; the default is ample for
# development.
DB_POOL_MAX=10

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080

# ── Browser-facing behaviour ────────────────────────────────────────────────
# The exact frontend origin, not a pattern. CORS with credentials cannot use a
# wildcard, and an exact value is what stops a lookalike domain reaching a
# staging host (NFR-SEC-CHANNEL, ADR-012).
FRONTEND_ORIGIN=http://localhost:3000

# Secure-flag on the session cookie. false only because localhost is http;
# anywhere with TLS must set this true, or the session cookie travels in clear.
COOKIE_SECURE=false

# How long a session lasts before it must be re-established. One day, per
# AMB-006 / NFR-SEC-SESSION. ISO-8601 duration.
SESSION_TTL=P1D

# ── Authentication ──────────────────────────────────────────────────────────
# Google OAuth client id, for the direct Google verification path. Leave blank
# and Google sign-in reports itself unconfigured rather than failing obscurely.
GOOGLE_CLIENT_ID=

# Keycloak, which brokers Google (ADR-013).
#
# Both or neither. An issuer with no audience refuses to start on purpose:
# without an audience, a token Keycloak minted for any other client in the same
# realm would verify here.
#
# Leave both blank and the Keycloak wiring does not exist at all — the
# application boots exactly as it does without it. Blank counts as absent.
KEYCLOAK_ISSUER_URI=
KEYCLOAK_AUDIENCE=

# ── Object storage ──────────────────────────────────────────────────────────
# S3-compatible API only, never a provider SDK (CONST-TECH-08). MinIO locally,
# anything speaking the same API in a deployment.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=coc-docs-media
S3_REGION=us-east-1
