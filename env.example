# Copy to env.local and fill in. env.local is gitignored; this file must never
# hold a real credential. Rationale for each setting: CONTRIBUTING.md.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cocdocs
DB_USER=cocdocs
DB_PASSWORD=
DB_POOL_MAX=10

# Server
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL=P1D

# Auth
GOOGLE_CLIENT_ID=
KEYCLOAK_ISSUER_URI=
KEYCLOAK_AUDIENCE=

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=coc-docs-media
S3_REGION=us-east-1
