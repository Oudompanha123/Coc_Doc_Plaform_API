# Copy to .env.local and fill in. .env.local is gitignored; this file must
# never hold a real credential. Rationale for each setting: CONTRIBUTING.md.
#
#   cp backend/.env.example backend/.env.local
#
# Not auto-loaded by Spring Boot/Maven on their own — see CONTRIBUTING.md
# ("Nothing exports .env.local at the OS level for you") for how it reaches
# the process: DotenvEnvironmentPostProcessor, the IntelliJ "Backend (dev)"
# run configuration, or sourcing it yourself:
#   set -a; . ./backend/.env.local; set +a

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cocdocs
DB_USER=cocdocs
DB_PASSWORD=
DB_POOL_MAX=10

# Your own schema on the shared server. Change cocdocs_dev to cocdocs_<your
# name>: own tables, own migration history, own data, so a migration on your
# branch cannot collide with anyone else's and resetting yours affects nobody.
# See CONTRIBUTING.md, "One server, one schema each".
#
# Must not be blank. An empty value is not the same as an unset one — it
# produces `currentSchema=` and the application refuses to start with
# "Unable to determine current schema as search_path is empty".
DB_SCHEMA=cocdocs_dev

# Server
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL=P1D

# Auth
GOOGLE_CLIENT_ID=
KEYCLOAK_ISSUER_URI=
KEYCLOAK_AUDIENCE=

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=coc-docs-media
S3_REGION=us-east-1

# Outbound email (ADR-017) — optional. spring-boot-starter-mail only
# autoconfigures a JavaMailSender when MAIL_HOST is set; leave these blank for
# local dev and the password-reset link is logged at WARN instead of emailed,
# same as the Keycloak broker degrades when its own settings are unset.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
