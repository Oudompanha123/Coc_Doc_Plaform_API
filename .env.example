# Copy to .env.local and fill in. .env.local is gitignored; this file must
# never hold a real credential. Rationale for each setting: CONTRIBUTING.md.
#
#   cp backend/.env.example backend/.env.local
#
# Not auto-loaded by Spring Boot/Maven on their own — see CONTRIBUTING.md
# ("Nothing exports .env.local at the OS level for you") for how it reaches
# the process: DotenvEnvironmentPostProcessor, the IntelliJ "Backend (dev)"
# run configuration, or sourcing it yourself:
#   set -a; . ./backend/.env.local; set +a

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cocdocs
DB_USER=cocdocs
DB_PASSWORD=
DB_POOL_MAX=10

# Your own schema on the shared server. REPLACE the placeholder below with
# your name — own tables, own migration history, own data, so a migration on
# your branch cannot collide with anyone else's and resetting yours affects
# nobody. See CONTRIBUTING.md, "One server, one schema each".
#
# This shipped as cocdocs_dev, which is a real person's schema, so copying
# this file unedited put you in their database. It is a placeholder now: it
# is not a schema anyone owns, and leaving it gives you your own empty one
# rather than somebody else's populated one.
#
# There is no default in application.yml either. Unset, the application
# refuses to start rather than guess. Must not be blank for the same reason —
# an empty value is not an unset one, it produces `currentSchema=` and fails
# with "Unable to determine current schema as search_path is empty".
DB_SCHEMA=cocdocs_changeme

# Server
PORT=8081
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL=P1D

# Auth
GOOGLE_CLIENT_ID=
KEYCLOAK_ISSUER_URI=
KEYCLOAK_AUDIENCE=

# Object storage (S3-compatible). Leave S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY
# blank and avatar upload stays disabled — the backend still boots and serves
# every other route, same degrade-gracefully convention as MAIL_* below.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=coc-docs-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Outbound email (ADR-017) — optional. spring-boot-starter-mail only
# autoconfigures a JavaMailSender when MAIL_HOST is set; leave these blank for
# local dev and the password-reset link is logged at WARN instead of emailed,
# same as the Keycloak broker degrades when its own settings are unset.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# Two more settings belong to outbound mail but are deliberately NOT listed as
# variables here, because scripts/check-env-documented.sh reads variable names
# out of the yml and neither of these is referenced there — they would show up
# forever as "documented but not read". Both reach their property through
# Spring Boot's relaxed environment binding, and both are worth knowing about:
#
#   APP_MAIL_FROM=Coc Docs Platform <someone@gmail.com>
#     -> app.mail.from. MUST be the MAIL_USERNAME account or a verified alias
#        of it; Google rewrites anything else. The default is a placeholder
#        domain nobody owns. See docs/ops/EMAIL-DELIVERY.md, "The From address".
#
#   APP_NOTIFICATIONS_RECIPIENTS=someone@gmail.com,ops@example.com
#     -> app.notifications.recipients. Who gets the daily activity digest.
#        Unset means every active admin and super_admin, which is the intended
#        default; setting it REPLACES that list rather than adding to it.

# Inbound: the HRMS mailbox watch (ADR-032). Off unless APP_HRMS_ENABLED is
# true, and no mailbox is opened at all until it is. Same relaxed-binding shape
# as APP_MAIL_FROM above -- none of these is referenced in the yml, so none is
# listed as a variable here.
#
#   APP_HRMS_ENABLED=true
#   APP_HRMS_USERNAME=someone@gmail.com
#   APP_HRMS_PASSWORD=<a 16-character Gmail App Password, NOT the account password>
#   APP_HRMS_SENDER=noreply-hrms@wecambodia.com
#
# Optional, with the defaults shown:
#   APP_HRMS_HOST=imap.gmail.com     APP_HRMS_PORT=993     APP_HRMS_FOLDER=INBOX
#   APP_HRMS_LOOKBACK=P7D            APP_HRMS_RETENTION=P90D
#   APP_HRMS_POLL_CRON=0 */30 * * * *     ("-" disables the schedule)
#
# APP_HRMS_PASSWORD IS A SECRET, and a broader one than it looks: an IMAP
# credential opens the whole mailbox, not just mail from APP_HRMS_SENDER. The
# sender filter is applied by this application, after the server has already
# handed it everything. See ADR-032 decision 4.
#
# Gmail also needs IMAP switched on for the account: Settings -> Forwarding and
# POP/IMAP -> Enable IMAP. Without it the connection authenticates and then
# finds nothing, which looks exactly like "no mail has arrived".

# Push notifications (ADR-025). The service-account JSON itself, on one line.
# THIS IS A SECRET — it can send to every registered device. Leave blank and
# the backend starts normally with push disabled, which is a supported state.
FIREBASE_CREDENTIALS=

# Keycloak realm import (scripts/keycloak-dev.sh). The Client Secret of the
# project's Google OAuth client — the pair to the client ID already in
# keycloak/docs_platform-realm.json. THIS IS A SECRET. Not read by the backend
# itself; the script passes it to Keycloak at realm import.
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Flyway, when somebody else's migration reaches the database before its file
# reaches the repository.
#
#   Detected applied migration not resolved locally: 17.
#
# The database has run a version this checkout has never heard of. application.
# yml already sets ignore-migration-patterns "*:missing", which covers a
# version BELOW your highest local one — a branch you have not merged. A
# version ABOVE it is `future`, and the message is identical, so the setting
# looks broken when it is simply not the case being described.
#
# Uncomment while you wait for that file to be pushed. Then delete the line:
# it also silences a genuinely deleted migration, which is a check worth having
# back. The real fix is the person who applied it pushing it, and — if you are
# sharing a schema with them — a DB_SCHEMA of your own, since a schema nobody
# else writes to cannot be ahead of your checkout.
#
# A property rather than an env var, because that is the name Spring binds and
# this file is imported as one.
# spring.flyway.ignore-migration-patterns=*:missing,*:future
